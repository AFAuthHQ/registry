# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Postgres (Railway provides DATABASE_URL automatically in production)
DATABASE_URL=postgres://registry:registry@localhost:5432/registry

# Redis (Railway provides REDIS_URL automatically in production)
REDIS_URL=redis://localhost:6379

# Shared secret for the revalidation cron endpoint (used if cron triggers externally;
# in-process node-cron does not require this)
REGISTRY_CRON_SECRET=change-me-in-prod

# Shared secret for admin take-down operations (operator-only)
REGISTRY_ADMIN_SECRET=change-me-in-prod

# Public base URL (used in generated proof URLs and operator pages)
PUBLIC_BASE_URL=https://registry.afauth.org

# Revalidation cron schedule (UTC). Default: daily at 06:00.
REGISTRY_CRON_SCHEDULE=0 6 * * *
